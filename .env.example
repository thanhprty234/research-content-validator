# ============================================================
# Model provider selection
# ============================================================
# Choose one: openai, anthropic, gemini, ollama, openrouter,
#            deepseek, groq, together, mistral, opencode, local, custom
MODEL_PROVIDER=openai

# Provider-specific API keys
OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=sk-ant-your-key
GEMINI_API_KEY=your-gemini-key
# (Ollama needs no key)
# OpenCode Zen gateway (https://opencode.ai/zen) - OpenAI-compatible
OPENCODE_API_KEY=

# Model name (defaults to OPENAI_MODEL if MODEL_NAME unset)
MODEL_NAME=gpt-4o-mini
# Optional: only the "openai"/"azure"/"local"/"custom" providers use this.
# For openrouter/deepseek/groq/together/mistral the correct base URL is applied automatically.
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: base URL for Ollama
OLLAMA_BASE_URL=http://localhost:11434

# Sampling
MODEL_TEMPERATURE=0.3
# Max output tokens. Default 16384. Raise it if you get a "length limit" /
# LengthFinishReason error (common with reasoning models like DeepSeek Flash).
MODEL_MAX_TOKENS=

# ============================================================
# Workflow
# ============================================================
MAX_REVISIONS=3
# Minimal critic score required for APPROVED (critic still returns REVISE below it).
APPROVE_THRESHOLD=85
# Checkpointer backend: memory | sqlite
CHECKPOINTER=memory
SQLITE_PATH=output/checkpoints.sqlite
THREAD_ID=default

# ============================================================
# Search
# ============================================================
# Optional live web search. Without it the pipeline uses offline placeholders.
TAVILY_API_KEY=

# ============================================================
# Observability (LangSmith)
# ============================================================
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=research-validator
