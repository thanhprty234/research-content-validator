# ============================================================
# Research & Content Validator — Environment Template
# ============================================================
# Copy this file to .env and fill in the values you need.
# Only the variables for your chosen provider are required.
# ============================================================

# ------------------------------------------------------------
# Model provider selection
# ------------------------------------------------------------
# Choose one: openai, anthropic, gemini, ollama, openrouter,
#            deepseek, groq, together, mistral, opencode,
#            azure, local, custom
MODEL_PROVIDER=opencode

# ------------------------------------------------------------
# Provider API keys — set ONLY the ones you need
# ------------------------------------------------------------
# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# OpenCode Zen (https://opencode.ai/zen) — OpenAI-compatible
# Free tier available; no key needed for some models.
OPENCODE_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Groq
GROQ_API_KEY=

# Together AI
TOGETHER_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_DEPLOYMENT_NAME=

# Custom / any OpenAI-compatible endpoint
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# ------------------------------------------------------------
# Model name
# ------------------------------------------------------------
# Required. Defaults to "gpt-4o-mini" if unset.
# Examples: gpt-4o-mini, gpt-4o, claude-3-haiku-20240307,
#           gemini-1.5-flash, deepseek-chat, llama-3.1-70b,
#           mixtral-8x7b, mistral-large-latest
MODEL_NAME=

# Optional: only used by openai/azure/local/custom providers.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: base URL for Ollama
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Sampling
# ------------------------------------------------------------
MODEL_TEMPERATURE=0.3

# Max output tokens per call. Default 4096.
# Raise it if you get a "length limit" / LengthFinishReason error
# (common with reasoning models like DeepSeek Flash).
MODEL_MAX_TOKENS=4096

# ------------------------------------------------------------
# Workflow
# ------------------------------------------------------------
# Maximum writer↔critic revision rounds
MAX_REVISIONS=3

# Minimal critic score (0–100) required for APPROVED.
# The critic still returns REVISE when the score is below this.
APPROVE_THRESHOLD=85

# Checkpointer backend: memory (default) | sqlite
CHECKPOINTER=memory

# Path to SQLite checkpoint database (only used when CHECKPOINTER=sqlite)
SQLITE_PATH=output/checkpoints.sqlite

# Default thread id for checkpointing
THREAD_ID=default

# ------------------------------------------------------------
# Search
# ------------------------------------------------------------
# Tavily web search (optional — DuckDuckGo fallback works without it).
# Get a key at https://tavily.com
TAVILY_API_KEY=

# Enable DuckDuckGo search via ddgs (free, no key needed).
# Set to true if TAVILY_API_KEY is not configured.
DDGS_ENABLED=true

# ------------------------------------------------------------
# Observability (LangSmith) — optional
# ------------------------------------------------------------
# Set LANGCHAIN_API_KEY to enable tracing on smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=research-validator

# ------------------------------------------------------------
# Budget guard — optional
# ------------------------------------------------------------
# Max USD to spend per run. The pipeline aborts early if exceeded.
# BUDGET=5.0
